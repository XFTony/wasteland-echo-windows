"tutorialSteps": [{
"detail": "人物、武器与四部位护具可在部署页左侧人物入口调整。",
"id": "deployment",
"target": 1.8,
"title": "行装确认"
}, {
"detail": "使用 WASD、方向键或左摇杆持续移动。",
"id": "move",
"target": 1.2,
"title": "穿过街区"
}, {
"detail": "默认自动瞄准并射击，移动靠近敌人完成 3 次开火；自动控制可在设置中调整。",
"id": "fire",
"target": 3.0,
"title": "自动锁定与射击"
}, {
"detail": "靠近经验、废料或医疗包完成拾取。",
"id": "pickup",
"target": 1.0,
"title": "回收战利品"
}, {
"detail": "升级时从四张卡中选择；满足前置条件后会出现终局进化。",
"id": "upgrade",
"target": 1.0,
