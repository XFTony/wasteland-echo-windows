{
  "name": "wasteland-echo-windows-game",
  "version": "1.5.0-alpha.1",
  "private": true,
  "description": "A zero-runtime-dependency Windows-first desktop roguelite with keyboard, mouse and gamepad input.",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "stage:desktop": "node scripts/build-web.mjs && node scripts/stage-desktop.mjs",
    "desktop:icon": "python scripts/generate-desktop-icon.py",
    "assets:font": "node scripts/subset-font.mjs",
    "assets:optimize": "python scripts/optimize-runtime-assets.py",
    "audit": "node scripts/audit-project.mjs --write",
    "check:version": "node scripts/check-version.mjs",
    "release:check:candidate": "node scripts/check-release.mjs --candidate",
    "release:check": "node scripts/check-release.mjs",
    "check": "node scripts/check-version.mjs && node scripts/build-web.mjs && node scripts/stage-desktop.mjs && node --test && node scripts/simulate-matrix.js 180 && node scripts/simulate-run.js 600 endless --stress-health && node scripts/audit-project.mjs",
    "test": "node --test",
    "verify": "node scripts/build-web.mjs && node --test && node scripts/simulate-matrix.js 180 && node scripts/simulate-run.js 600 endless --stress-health && node scripts/browser-fps.mjs --assert",
    "play": "node scripts/build-web.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "simulate": "node scripts/simulate-run.js 180 --normal-health",
    "simulate:matrix": "node scripts/simulate-matrix.js 180 --write",
    "simulate:endless": "node scripts/simulate-run.js 600 endless --stress-health",
    "benchmark:render": "node scripts/benchmark-render.js",
    "benchmark:browser": "node scripts/browser-fps.mjs --write --assert",
    "benchmark:browser:full": "node scripts/browser-fps.mjs --full --write --assert"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
